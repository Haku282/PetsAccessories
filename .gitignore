# Bỏ qua tất cả file trong thư mục upload
/backend/upload/avatar/*
/backend/upload/imgProduct/*

# NHƯNG không bỏ qua file .gitkeep (để giữ lại cấu trúc thư mục trên Git)
!/backend/upload/avatar/.gitkeep
!/backend/upload/imgProduct/.gitkeep

# Loại bỏ thư mục thư viện của Composer (Bắt buộc)
/vendor/

# Loại bỏ các file cấu hình môi trường chứa mật khẩu/API key
.env
.env.local

# Loại bỏ các file rác của hệ điều hành
Thumbs.db
.DS_Store

# Loại bỏ file log và cache (nếu có)
*.log
/storage/*.php